# =========================================
# 🚀 前端忽略项 (React + Vite)
# =========================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================
# ☕ 后端忽略项 (Spring Boot + Maven)
# =========================================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.log
logs/

# =========================================
# 🔒 敏感数据与隐私文件 (极度重要)
# =========================================
# 本地用户上传的图片（绝对不能传，否则仓库会爆炸）
uploads/

# 如果你以后创建了本地专用的配置文件（如密码等），也在此屏蔽
application-local.yml
application-prod.yml
.env
.env.local

# 如果还有以前 H2 数据库的遗留文件，一并屏蔽
data/
*.db
*.mv.db
*.trace.db

# =========================================
# 💻 编辑器与操作系统忽略项
# =========================================
.vscode/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache

# Mac 系统文件
.DS_Store

# Windows 系统文件
Thumbs.db
Desktop.ini

# =========================================
# 💻 添加的skill
# =========================================
.dsh/