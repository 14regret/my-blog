# =========================================
# 🚀 前端忽略项 (React + Vite)
# =========================================
node_modules/      # 依赖包（极度重要！千万不能传）
dist/              # 打包构建后的静态文件
.vite/             # Vite 缓存
npm-debug.log*     # 报错日志
yarn-debug.log*
yarn-error.log*

# =========================================
# ☕ 后端忽略项 (Spring Boot + Maven)
# =========================================
target/            # Maven 编译后的 .class 和 .jar 文件（极度重要！）
.mvn/              # Maven 包装器
mvnw
mvnw.cmd
*.class            # 编译后的 Java 文件
*.log              # 运行日志

# =========================================
# 💾 业务数据忽略项 (极度重要！)
# =========================================
data/              # H2 数据库本地文件（包含你的测试文章和用户密码，绝不能公开）
uploads/           # 用户上传的图片文件（传到 Git 会让仓库爆炸）
*.db               # 其他数据库文件
*.mp3              # 如果你有本地测试音乐也可以忽略（但 bgm.mp3 放在 public 里，这里不影响）

# =========================================
# 💻 编辑器与操作系统忽略项
# =========================================
.vscode/           # VSCode 的个人配置（包含本地路径）
.idea/             # IntelliJ IDEA 配置
*.iml
.DS_Store          # Mac 系统的隐藏文件
Thumbs.db          # Windows 系统的缩略图文件